{
  "hosts": 5,
  "switches": 8,
  "seed": 42,
  "k": 2,
  "host_degree_min": 2,
  "host_degree_max": 3,
  "switch_use_all": false,
  "node_per_switch": 2,

  "num": 1,
  "output_dir": "logs",
  "timestamp": false,
  "legacy_layout": false,
  "topo_png": "topology.png",
  "topo_layout": "spring",
  "script_log": "script.log",
  "no_script_log": false,

  "down_interval": 30,
  "down_duration": 10,
  "down_count": 1,
  "down_stagger": 2,
  "down_exclude": "0,4",

  "cache_count": 2,
  "cache_default_rct_ms": 10000,

  "routing": {
    "strategy": "dijkstra"
  },

  "cache_config": {
    "strategy": "k_centers",
    "default": {
      "count": 2,
      "capacity": 819200,
      "default_rct_ms": 10000,
      "algorithm": "LRU",
      "type": "memory"
    }
  },

  "puts": [
    {
      "host": 4,
      "uri": "ccnx:/test/sample",
      "file": "./sample-putfile",
      "rate": 10,
      "block_size": 1024,
      "expiry": 3000,
      "cache_time": 3000,
      "valid_algo": "crc32c"
    }
  ],

  "gets": [
    {
      "host": 0,
      "uri": "ccnx:/test/sample"
    }
  ],

  "events": [
    {
      "at": 15,
      "type": "link_down",
      "nodes": [1, 2]
    },
    {
      "at": 25,
      "type": "link_up",
      "nodes": [1, 2]
    },
    {
      "at": 30,
      "type": "bw_set",
      "nodes": [0, 3],
      "bandwidth": 5
    },
    {
      "at": 40,
      "type": "bw_set",
      "nodes": [1, 3],
      "bandwidth": 1,
      "repeat": {
        "interval": 30,
        "duration": 10,
        "restore": { "bandwidth": 10 },
        "count": 3
      }
    }
  ],

  "warmup_get_interval": 0,
  "warmup_only_cache_nodes": true,
  "hot_uris": ["ccnx:/test/sample"],

  "no_cli": false,
  "duration": 0,
  "results_json": "",
  "get_interval": 10,

  "publisher_host": 4,

  "bw": [],
  "ext": [],
  "bridges": []
}
