{
  "hosts": 5,
  "switches": 8,
  "seed": 42,
  "k": 2,
  "host_degree_min": 2,
  "host_degree_max": 3,
  "switch_use_all": false,
  "node_per_switch": 2,

  "num": 1,
  "output_dir": "logs",
  "timestamp": false,
  "topo_png": "topology.png",
  "topo_layout": "spring",
  "script_log": "script.log",
  "no_script_log": false,

  "down_interval": 30,
  "down_duration": 10,
  "down_count": 1,
  "down_stagger": 2,
  "down_exclude": "0,4",

  "cache_count": 2,
  "cache_default_rct_ms": 10000,

  "routing": {
    "strategy": "dijkstra"
  },

  "cache_config": {
    "strategy": "k_centers",
    "default": {
      "count": 2,
      "capacity": 819200,
      "default_rct_ms": 10000,
      "algorithm": "LRU",
      "type": "memory"
    }
  },

  "pubsub_sub_startup_grace": 1.0,

  "events": [
    { "at": 15, "type": "link_down", "nodes": [0, 1] },
    { "at": 25, "type": "link_up",   "nodes": [0, 1] },
    { "at": 30, "type": "bw_set", "nodes": [0, 2], "bandwidth": 5 },
    {
      "at": 40,
      "type": "bw_set",
      "nodes": [1, 4],
      "bandwidth": 1,
      "repeat": {
        "interval": 30,
        "duration": 10,
        "restore": { "bandwidth": 10 },
        "count": 3
      }
    },
    {
      "at": 35,
      "type": "put",
      "host": 4,
      "uri": "ccnx:/test/sample",
      "file": "./sample-putfile",
      "rate": 10,
      "block_size": 1024,
      "expiry": 3000,
      "cache_time": 3000,
      "valid_algo": "crc32c"
    },
    {
      "at": 45,
      "type": "get",
      "host": 0,
      "uri": "ccnx:/test/sample"
    },
    {
      "at": 55,
      "type": "pubsub_sub",
      "host": 0,
      "uri": "ccnx:/test/event_stream",
      "sub_opts": { "wait": 20 }
    },
    {
      "at": 55,
      "type": "pubsub_pub",
      "host": 4,
      "uri": "ccnx:/test/event_stream",
      "file": "./sample-putfile",
      "pub_opts": { "lifetime": 8 }
    }
  ],

  "no_cli": false,
  "duration": 0,
  "results_json": "",

  "publisher_host": 4,

  "bw": [],
  "ext": [],
  "bridges": [],

  "addressing": {
    "network_cidr": "192.168.0.0/16"
  },

  "debug": false
}
