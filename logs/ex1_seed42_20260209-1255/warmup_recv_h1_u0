#MainArticle {
  color: #eee;
  padding: 8px;
  flex: 1;
  min-width: 0; 
  /* 長いコンテンツをはみ出させないために重要 */
}
#MainArticle h1, #MainArticle h2, #MainArticle h3, #MainArticle h4, #MainArticle h5, #MainArticle h6 {
  color: #eee;
}
#PBSimply {
  padding: 8px;
  text-align: right;
  border-top: 2px solid #6b84df;
}
#SideBar {
  width: 240px;
  background-color: #1e1e1e;
  color: #eee;
  padding: 1rem;
  border-radius: 8px;
  flex-shrink: 0;
}

#SideBar a {
  color: #a8c4ff;
  text-decoration: none;
}

#SideBar a:hover {
  text-decoration: underline;
}

.menu-toggle {
  display: none;
  background-color: #444;
  color: #fff;
  border: none;
  padding: 0.75rem 1.25rem;
  font-size: 1rem;
  cursor: pointer;
  width: 100%;
  text-align: left;
}
@media screen and (min-width: 800px) {
  #ContentContainer {
    flex-direction: row;
  }
  #MainArticle {
    order: 1;
    width: 100%;
  }
  #SideBar {
    order: 2;
}
@media screen and (max-width: 799px) {
  #ContentContainer { 
    flex-direction: row; 
  }
  #MainArticle {
    order: 1;
    width: 100%;
  }
  #SideBar {
    order: 2;
    display: none; /* 初期は非表示 */
  }
  #SideBar.open {
    display: block;
  }
  .menu-toggle {
    display: block;
  }
}

  /* light mode scheme */

@media (prefers-color-scheme: light) {
  body {
    background-color: #f0f0f0;
  }

  p {
    color: #1d1d1d;
  }
}