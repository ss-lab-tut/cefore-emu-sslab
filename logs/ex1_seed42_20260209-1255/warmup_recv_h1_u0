body, html {
  margin: 0;
  padding: 0;
  max-width: flex;
  background-color: #222;
}
#Overall {
  max-width: flex;
  margin: 0 auto;
  background-color: #222
}
#BannerHeader {
  height: 200px;
  width: 100%;
}

#ContentContainer {
  display: flex;
  width: 100%;
  flex-direction: row;
  gap: 2rem;
  align-items: flex-start;
  margin: auto;
}

#BannerHeader {
  background-color: #121820;
  border-radius: 2px;
  color: #eee;
}
#BannerHeader h1 {
  font-size: 2.1rem;
  text-align: center;
  position: relative;
  top: calc(50% - 1em);
}
#BannerHeader h2 {
  font-size: 1.2rem;
  text-align: center;
  position: relative;
  top: 1.25em;
}

#NavigationColumn ul {
  list-style: none;
  list-style-type: none;
  list-style-position: outside;
  margin: 0;
  padding: 0;
  text-align: center;
}
#NavigationColumn li {
  background-color: #393b63;
  border: 2px solid #232538;
  color: #eee;
  border-radius: 6px;
  margin: 3px 1px;
  padding: 2px;
  overflow: hidden;
}
#NavigationColumn a {
  display: block;
  padding: 0.75rem 1rem;
  background-color: #2a2a2a;
  color: #8dc2ff;
  text-decoration: none;
  transition: background-color 0.2s ease;
}
#NavigationColumn a:hover {
  background-color: #3e5c8b;
  color: #ffffff;
}
