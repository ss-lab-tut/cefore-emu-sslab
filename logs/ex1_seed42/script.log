h0 command: ifconfig h0-eth0 192.168.1.1
h2 command: ifconfig h2-eth0 192.168.1.3
h3 command: ifconfig h3-eth0 192.168.1.4
h4 command: ifconfig h4-eth0 192.168.1.5
h1 command: ifconfig h1-eth0 192.168.2.2
h4 command: ifconfig h4-eth1 192.168.2.5
h0 command: ifconfig h0-eth1 192.168.3.1
h1 command: ifconfig h1-eth1 192.168.3.2
h2 command: ifconfig h2-eth1 192.168.3.3
h3 command: ifconfig h3-eth1 192.168.3.4
h4 command: ifconfig h4-eth2 192.168.3.5
h3 command: ifconfig h3-eth2 192.168.4.4
h0 command: csmgrdstart -d ./h0 > /dev/null 2>&1
h1 command: csmgrdstart -d ./h1 > /dev/null 2>&1
h0 command: cefnetdstart -d ./h0 > /dev/null 2>&1
h1 command: cefnetdstart -d ./h1 > /dev/null 2>&1
h2 command: cefnetdstart -d ./h2 > /dev/null 2>&1
h3 command: cefnetdstart -d ./h3 > /dev/null 2>&1
h4 command: cefnetdstart -d ./h4 > /dev/null 2>&1
